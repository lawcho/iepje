Index1D = Nat
X = Nat
Y = Nat

get1D : Index1D → Model → Bool
get1D = Arr.get-with-default false

flatten : X → Y → Index1D
flatten x y = x % w + (y % w) * w

get2D : X → Y → Model → Bool
get2D x y = get1D (flatten x y)

xOf : Index1D → X
xOf = _% w

yOf : Index1D → Y
yOf = _/ w

neighbours : Index1D -> Model -> List Bool
neighbours i m =
  let x = xOf i in
  let y = yOf i in
  get2D (x - 1) (y - 1) m ∷ get2D (x   ) (y - 1) m ∷ get2D (x + 1) (y - 1) m ∷
  get2D (x - 1) (y    ) m ∷                          get2D (x + 1) (y    ) m ∷
  get2D (x - 1) (y + 1) m ∷ get2D (x   ) (y + 1) m ∷ get2D (x + 1) (y + 1) m ∷
  []

count : List Bool → Nat
count [] = 0
count (false ∷ l) = count l
count (true ∷ l) = 1 + count l

step : Model → Model
step m = Arr.indexed-map
  (λ i b →
    case count (neighbours i m) of λ where
      0 → false
      1 → false
      2 → b
      3 → true
      _ → false
  )
  m

data Msg : Set where
  flip : Index1D → Msg

update : Msg → Model → Model
update (flip i) model = Arr.set i (not (get1D i model)) model

view-cell : Index1D → Bool → Html Msg
view-cell i b = button (flip i) do
  style "background" (if b then "green" else "black")

view : Model → Html Msg
view model = div do
  style "display" "grid"
  style "grid-template-rows" ("repeat(" ++ primShowNat w ++ ",1cm)")
  style "grid-template-columns" ("repeat(" ++ primShowNat w ++ ",1cm)")
  concatDocs $ Arr.indexed-map view-cell model

conway : IO ⊤
conway = play "#conway-game" fps init view update λ _ → step
